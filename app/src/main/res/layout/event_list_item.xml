<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
<data><import type="android.view.View"/><variable name="simpleMode" type="Boolean"/></data>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:orientation="horizontal">
<com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" style="?materialCardViewFilledStyle" app:cardBackgroundColor="?colorSurfaceContainer" app:shapeAppearance="?shapeAppearanceCornerLarge" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<View android:id="@+id/typeColor" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="8dp" android:background="@drawable/unread_red_circle"/>
<com.mikepenz.iconics.view.IconicsImageView android:id="@+id/attachmentIcon" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="8dp" app:iiv_color="?colorOnSurfaceVariant" app:iiv_icon="cmd-attachment"/>
<TextView android:id="@+id/details" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:textAppearance="?textAppearanceLabelMedium" tools:text="sprawdzian • 9:05 • historia i społeczeństwo"/>
<View android:id="@+id/unread" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:background="@drawable/unread_red_circle" android:visibility="gone" tools:visibility="visible"/>
</LinearLayout>
<com.mikepenz.iconics.view.IconicsTextView android:id="@+id/topic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="3" tools:text="Rozdział II: Panowanie Piastów i Jagiellonów."/>
<com.mikepenz.iconics.view.IconicsTextView android:id="@+id/addedBy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="middle" android:isVisible="@{!simpleMode}" android:singleLine="true" android:textAppearance="?textAppearanceBodySmall" tools:text="Udostępniono przez klasę"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.button.MaterialButton android:id="@+id/editButton" style="?materialIconButtonSecondaryStyle" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:fontFamily="@font/community_material_font_v5_8_55" android:minWidth="0dp" android:text="" android:textSize="20sp" tools:visibility="visible"/>
</LinearLayout>
</layout>