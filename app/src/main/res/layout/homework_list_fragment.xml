<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02091A">

    <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="18dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Zadania" android:textColor="#F7F7FF" android:textSize="25sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="Twoje zadania i prace domowe"
            android:textColor="#9BA8C4" android:textSize="12sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="14dp" android:gravity="center_vertical">
            <TextView android:id="@+id/filterAll" android:layout_width="wrap_content" android:layout_height="36dp"
                android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                android:background="@drawable/aximo_plan_day_selected" android:text="Wszystkie"
                android:textColor="#FFFFFF" android:textSize="12sp"/>
            <TextView android:id="@+id/filterTodo" android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/aximo_more_card" android:text="Do zrobienia"
                android:textColor="#B8C1D8" android:textSize="12sp"/>
            <TextView android:id="@+id/filterDone" android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/aximo_more_card" android:text="Zrobione"
                android:textColor="#B8C1D8" android:textSize="12sp"/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/noData" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="24dp"
            android:text="@string/homework_no_data" android:textColor="#FFFFFF" android:visibility="gone"
            app:drawableTopCompat="@drawable/ic_no_homework" tools:visibility="visible"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipToPadding="false" android:paddingTop="8dp"
            android:paddingBottom="112dp" android:overScrollMode="never" android:visibility="gone"
            tools:listitem="@layout/event_list_item" tools:visibility="visible"/>
    </LinearLayout>
</FrameLayout>