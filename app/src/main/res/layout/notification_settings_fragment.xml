<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="#02091A">

 <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true"
  android:clipToPadding="false" android:paddingBottom="108dp"
  app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
  app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
   android:orientation="vertical" android:padding="18dp">

   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <ImageButton android:id="@+id/backButton" android:layout_width="44dp" android:layout_height="44dp"
     android:background="@drawable/aximo_notification_header_icon" android:src="@drawable/ic_aximo_back"
     android:tint="#FFFFFF" android:contentDescription="Wstecz"/>
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
     android:layout_marginStart="12dp" android:text="Ustawienia powiadomień" android:textColor="#FFFFFF"
     android:textSize="23sp" android:textStyle="bold"/>
   </LinearLayout>

   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
    android:text="Powiadomienia aplikacji" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>

   <com.google.android.material.materialswitch.MaterialSwitch
    android:id="@+id/lessonNotifications" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:text="Przypomnienia o lekcjach"
    android:textColor="#FFFFFF" android:textSize="15sp"
    android:buttonTint="#A96CFF"/>

   <com.google.android.material.materialswitch.MaterialSwitch
    android:id="@+id/automaticSilence" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="2dp" android:text="Automatyczne wyciszanie"
    android:textColor="#FFFFFF" android:textSize="15sp"/>

   <LinearLayout android:id="@+id/silencePermissionCard" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:padding="16dp" android:orientation="vertical"
    android:background="@drawable/aximo_notification_settings_card">
    <TextView android:id="@+id/silencePermissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
     android:text="Sprawdzanie dostępu do trybu Nie przeszkadzać…" android:textColor="#AEBBD2" android:textSize="13sp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/silencePermissionButton"
     android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
     android:text="Nadaj dostęp do wyciszania" android:textAllCaps="false"/>
   </LinearLayout>
   <com.google.android.material.materialswitch.MaterialSwitch
    android:id="@+id/lessonNameNotifications" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="2dp" android:text="Nazwa lekcji w powiadomieniu"
    android:textColor="#FFFFFF" android:textSize="15sp"/>
   <com.google.android.material.materialswitch.MaterialSwitch
    android:id="@+id/planChangeNotifications" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="2dp" android:text="Zmiany planu lekcji"
    android:textColor="#FFFFFF" android:textSize="15sp"/>
   <com.google.android.material.materialswitch.MaterialSwitch
    android:id="@+id/systemNotifications" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="2dp" android:text="Powiadomienia systemowe"
    android:textColor="#FFFFFF" android:textSize="15sp"/>

   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/aximo_notification_settings_card">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
     android:text="Przypomnienie przed lekcją" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
    <TextView android:id="@+id/minutesValue" android:layout_width="match_parent" android:layout_height="wrap_content"
     android:layout_marginTop="5dp" android:textColor="#AEBBD2" android:textSize="13sp"/>
    <SeekBar android:id="@+id/minutesSeek" android:layout_width="match_parent" android:layout_height="wrap_content"
     android:max="30" android:progress="10" android:layout_marginTop="5dp"/>
   </LinearLayout>

   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
    android:text="Rodzaje powiadomień" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>

   <LinearLayout android:id="@+id/filterCard" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:padding="16dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@drawable/aximo_notification_settings_card">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
     android:text="Wybierz, co ma Cię powiadamiać" android:textColor="#FFFFFF" android:textSize="14sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
     android:text="›" android:textColor="#A96CFF" android:textSize="28sp"/>
   </LinearLayout>

   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
    android:text="Zmiany są zapisywane automatycznie" android:textColor="#71809C" android:textSize="12sp"/>
  </LinearLayout>
 </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>