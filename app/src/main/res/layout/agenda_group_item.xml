<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
 android:id="@+id/card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp"
 app:cardBackgroundColor="#171C2A" app:cardCornerRadius="17dp" app:cardElevation="0dp" app:strokeColor="#2C3547" app:strokeWidth="1dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="5dp">
<TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:padding="10dp" android:textColor="#E9EDF4" android:textSize="13sp" android:textStyle="bold" tools:text="informacja"/>
<TextView android:id="@+id/count" android:layout_width="46dp" android:layout_height="42dp" android:layout_marginVertical="2dp" android:background="@drawable/bg_rounded_8dp" android:gravity="center" android:textColor="#B9B1FF" android:textSize="17sp" android:textStyle="bold" tools:backgroundTint="#25213A" tools:text="3"/>
</LinearLayout>
<View android:id="@+id/badge" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="end" android:layout_marginTop="-3dp" android:layout_marginEnd="6dp" android:background="@drawable/unread_red_circle"/>
</com.google.android.material.card.MaterialCardView>