<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#02091A">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="120dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical"><ImageButton android:id="@+id/backButton" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/aximo_icon_button_background" android:src="@drawable/ic_aximo_back" android:tint="#FFFFFF"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Pomoc" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"/></LinearLayout>
<EditText android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:hint="Szukaj odpowiedzi..." android:textColor="#FFFFFF" android:hintTextColor="#7F8BA8" android:background="@drawable/aximo_notification_settings_card" android:paddingStart="16dp" android:paddingEnd="16dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Jak możemy pomóc?" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
<LinearLayout android:id="@+id/faqCard" style="@style/AximoMoreCard" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:paddingStart="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Najczęściej zadawane pytania" android:textColor="#FFFFFF" android:textSize="15sp"/></LinearLayout>
<LinearLayout android:id="@+id/guideCard" style="@style/AximoMoreCard" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingStart="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Instrukcja obsługi" android:textColor="#FFFFFF" android:textSize="15sp"/></LinearLayout>
<LinearLayout android:id="@+id/contactCard" style="@style/AximoMoreCard" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingStart="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kontakt" android:textColor="#FFFFFF" android:textSize="15sp"/></LinearLayout>
<LinearLayout android:id="@+id/problemCard" style="@style/AximoMoreCard" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingStart="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Zgłoś problem" android:textColor="#FFFFFF" android:textSize="15sp"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="18dp" android:background="@drawable/aximo_more_quote" android:gravity="center" android:text="Razem tworzymy lepszą szkołę.&#10;— Aximo" android:textColor="#F4EFFF" android:textSize="14sp" android:textStyle="bold"/></LinearLayout></ScrollView>