<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05081A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/aximo_icon_button_background"
                android:contentDescription="Wstecz"
                android:src="@drawable/ic_aximo_back"
                android:tint="#F7F1FF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wygląd Aximo"
                    android:textColor="#F7F1FF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Dopasuj aplikację do siebie"
                    android:textColor="#8F9DBB"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Motyw"
            android:textColor="#F7F1FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/themeDark"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/aximo_more_card"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☾" android:textColor="#C9AEFF" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Ciemny" android:textColor="#F7F1FF" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeLight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/aximo_more_card"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀" android:textColor="#FFD36E" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Jasny" android:textColor="#F7F1FF" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeAuto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/aximo_more_card"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◐" android:textColor="#8FD7FF" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Auto" android:textColor="#F7F1FF" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Style Aximo"
            android:textColor="#F7F1FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="20 przygaszonych stylów — bez rażących kolorów"
            android:textColor="#8F9DBB"
            android:textSize="12sp" />

        <GridLayout
            android:id="@+id/styleGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:columnCount="2"
            android:useDefaultMargins="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Kolor akcentu"
            android:textColor="#F7F1FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="9dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/accentRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/aximo_more_card"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View android:id="@+id/accentPurple" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#8D72FF"/>
                <View android:id="@+id/accentBlue" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#5B8DFF"/>
                <View android:id="@+id/accentCyan" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#42C9D8"/>
                <View android:id="@+id/accentGreen" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#61C58A"/>
                <View android:id="@+id/accentYellow" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#D7B451"/>
                <View android:id="@+id/accentOrange" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#D58A50"/>
                <View android:id="@+id/accentPink" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#D77ABF"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Tło"
            android:textColor="#F7F1FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/bgDefault" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Domyślne" android:textColor="#F7F1FF" android:textSize="11sp"/>
            <TextView android:id="@+id/bgMountains" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Góry" android:textColor="#F7F1FF" android:textSize="11sp"/>
            <TextView android:id="@+id/bgSea" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Morze" android:textColor="#F7F1FF" android:textSize="11sp"/>
            <TextView android:id="@+id/bgCity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Miasto" android:textColor="#F7F1FF" android:textSize="11sp"/>
            <TextView android:id="@+id/bgAbstract" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Abstrakt" android:textColor="#F7F1FF" android:textSize="10sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/bgCustom"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/aximo_icon_button_background"
            android:gravity="center"
            android:text="＋ Wybierz własne zdjęcie"
            android:textColor="#D4BEFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appearanceSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Zmiany są zapisywane automatycznie"
            android:textColor="#8E829F"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>