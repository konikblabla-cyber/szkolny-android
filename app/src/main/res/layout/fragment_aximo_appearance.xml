<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/appearanceRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/aximo_icon_button_background"
                android:contentDescription="Wstecz"
                android:src="@drawable/ic_aximo_back"
                android:tint="#F7F1FF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wygląd Aximo"
                    android:textColor="#F7F1FF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Dopasuj aplikację do siebie"
                    android:textColor="#8F9DBB"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Motyw"
            android:textColor="#F7F1FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/themeDark"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/aximo_more_card"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☾" android:textColor="#C9AEFF" android:textSize="28sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Ciemny" android:textColor="#F7F1FF" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeLight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/aximo_more_card"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀" android:textColor="#FFD36E" android:textSize="28sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Jasny" android:textColor="#F7F1FF" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeAuto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/aximo_more_card"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◐" android:textColor="#8FD7FF" android:textSize="28sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Auto" android:textColor="#F7F1FF" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Style Aximo"
            android:textColor="#F7F1FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="20 przygaszonych stylów — bez rażących kolorów"
            android:textColor="#8F9DBB"
            android:textSize="12sp" />

        <GridLayout
            android:id="@+id/styleGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:columnCount="2"
            android:useDefaultMargins="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Kolor akcentu"
            android:textColor="#F7F1FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/accentRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/aximo_more_card"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View android:id="@+id/accentPurple" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#8D72FF"/>
                <View android:id="@+id/accentBlue" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#5B8DFF"/>
                <View android:id="@+id/accentCyan" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#42C9D8"/>
                <View android:id="@+id/accentGreen" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#61C58A"/>
                <View android:id="@+id/accentYellow" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#D7B451"/>
                <View android:id="@+id/accentOrange" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#D58A50"/>
                <View android:id="@+id/accentPink" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/aximo_accent_circle" android:backgroundTint="#D77ABF"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Tło"
            android:textColor="#F7F1FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView android:id="@+id/bgBlack" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Czarne" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgDefault" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Domyślne" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgMountains" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Góry" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgSea" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Ocean" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgCity" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Aurora" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgAbstract" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Kosmos" android:textColor="#F7F1FF" android:textSize="10sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgSunset" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Zachód" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgForest" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Las" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgRain" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Deszcz" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgEmber" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Żar" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgLavender" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Lawenda" android:textColor="#F7F1FF" android:textSize="10sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgNeon" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Neon" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgMist" android:layout_width="94dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Mgła" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
                <TextView android:id="@+id/bgStars" android:layout_width="94dp" android:layout_height="match_parent" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="Gwiazdy" android:textColor="#F7F1FF" android:textSize="11sp"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Własne tapety"
            android:textColor="#AFA3C8"
            android:textSize="12sp" />

        <GridLayout
            android:id="@+id/customWallpaperGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="5"
            android:useDefaultMargins="false">
            <TextView android:id="@+id/customBg1" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_marginEnd="4dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="+ 1" android:textColor="#D4BEFF" android:textSize="11sp" 
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
            <TextView android:id="@+id/customBg2" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_marginStart="2dp" android:layout_marginEnd="4dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="+ 2" android:textColor="#D4BEFF" android:textSize="11sp" 
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
            <TextView android:id="@+id/customBg3" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_marginStart="2dp" android:layout_marginEnd="4dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="+ 3" android:textColor="#D4BEFF" android:textSize="11sp" 
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
            <TextView android:id="@+id/customBg4" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_marginStart="2dp" android:layout_marginEnd="4dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="+ 4" android:textColor="#D4BEFF" android:textSize="11sp" 
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
            <TextView android:id="@+id/customBg5" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_marginStart="2dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:text="+ 5" android:textColor="#D4BEFF" android:textSize="11sp" 
                android:foreground="?attr/selectableItemBackgroundBorderless"/>
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Dodatkowe ustawienia"
            android:textColor="#F7F1FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Więcej opcji wyglądu — każda zmiana zapisuje się od razu"
            android:textColor="#8F9DBB"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/aximo_more_card"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zaokrąglenie kart"
                android:textColor="#F7F1FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/cardRoundness"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="28"
                android:progress="18" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Przezroczystość kart"
                android:textColor="#F7F1FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/surfaceTransparency"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="65"
                android:progress="18" />

            <TextView
                android:id="@+id/surfaceTransparencyValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="18% przezroczystości"
                android:textColor="#8F9DBB"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cardRoundnessValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="18 dp"
                android:textColor="#8F9DBB"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#26FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Animacje interfejsu"
                        android:textColor="#F7F1FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Płynne przejścia i efekty"
                        android:textColor="#8F9DBB"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/animationsEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delikatne karty"
                        android:textColor="#F7F1FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lekko przezroczyste panele, bardziej widać tapetę"
                        android:textColor="#8F9DBB"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/softCards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/appearanceSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Zmiany są zapisywane automatycznie"
            android:textColor="#8E829F"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>