<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#101B2A" app:cardCornerRadius="20dp" app:cardElevation="0dp"
    app:strokeColor="#25344A" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="11dp">
        <ImageView android:id="@+id/image" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginEnd="11dp" tools:srcCompat="@drawable/bg_circle"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="marquee" android:singleLine="true"
                android:textColor="#F2F4FA" android:textSize="15sp" android:textStyle="bold" tools:text="Jan Kowalski"/>
            <TextView android:id="@+id/type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="marquee" android:singleLine="true"
                android:textColor="#8F98A9" android:textSize="11sp" tools:text="Nauczyciel"/>
        </LinearLayout>
        <com.mikepenz.iconics.view.IconicsImageButton android:id="@+id/sendMessage" android:layout_width="36dp" android:layout_height="36dp" android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp" android:visibility="gone" app:iiv_color="#A99DFF" app:iiv_icon="cmd-email-plus-outline" app:iiv_size="21dp" tools:visibility="visible"/>
        <com.mikepenz.iconics.view.IconicsImageButton android:id="@+id/copy" android:layout_width="36dp" android:layout_height="36dp" android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp" android:visibility="gone" app:iiv_color="#9299AB" app:iiv_icon="cmd-clipboard-text-multiple-outline" app:iiv_size="21dp" tools:visibility="visible"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>