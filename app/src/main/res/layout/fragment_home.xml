<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="26dp"
        android:paddingEnd="18dp"
        android:paddingBottom="126dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="68dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Poniedziałek, 22 września"
                    android:textColor="#9DA9C7"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/homeGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cześć!"
                    android:textColor="#FFFFFF"
                    android:textSize="29sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/homeSettingsHit"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/aximo_icon_button_background"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ustawienia"/>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/nowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/aximo_hero_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TERAZ / NASTĘPNA LEKCJA"
                    android:textColor="#BBA6FF"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/nowLessonCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sprawdzam…"
                    android:textColor="#DDE3FF"
                    android:textSize="11sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/nowLesson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Plan lekcji"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/nowLessonDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Ładowanie danych…"
                android:textColor="#B7C0DA"
                android:textSize="13sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/aximo_chip_background"
                android:paddingStart="11dp"
                android:paddingTop="7dp"
                android:paddingEnd="11dp"
                android:paddingBottom="7dp"
                android:text="Otwórz plan →"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Dzisiaj"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/todaySummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/aximo_section_background"
            android:orientation="horizontal"
            android:padding="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="96dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/todayLessonsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lekcje" android:textColor="#8793B1" android:textSize="11sp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="48dp" android:layout_gravity="center" android:background="#25304C"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="82dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/todayTasksCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zadania" android:textColor="#8793B1" android:textSize="11sp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="48dp" android:layout_gravity="center" android:background="#25304C"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="82dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/todayAttendance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Frekwencja" android:textColor="#8793B1" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Szybki dostęp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <HorizontalScrollView
            android:id="@+id/quickActions"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView android:id="@+id/quickPlan" style="@style/AximoHomeQuickCard" android:text="▣
Plan"/>
                <TextView android:id="@+id/quickHomework" style="@style/AximoHomeQuickCard" android:text="✓
Zadania"/>
                <TextView android:id="@+id/quickGrades" style="@style/AximoHomeQuickCard" android:text="★
Oceny"/>
                <TextView android:id="@+id/quickTomorrow" style="@style/AximoHomeQuickCard" android:text="→
Jutro"/>
                <TextView android:id="@+id/quickMessages" style="@style/AximoHomeQuickCard" android:text="✉
Wiadomości"/>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/focusStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/aximo_focus_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/focusStatusDot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/aximo_focus_dot" android:text=""/>
                <TextView android:id="@+id/focusStatusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Tryb szkolny" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/focusStatusDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Automatyczne wyciszanie telefonu" android:textColor="#8F9AB8" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/configHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">
            <Button
                android:id="@+id/configureCards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Dostosuj"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            tools:listitem="@layout/card_home_timetable"/>

        <ImageView
            android:id="@+id/homeReferenceImage"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:src="@drawable/aximo_home_reference"
            android:contentDescription="@null"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>