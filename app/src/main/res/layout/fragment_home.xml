<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:fillViewport="true"
    android:overScrollMode="never">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="700dp">

        <!-- Exact first screen from the supplied Aximo reference. -->
        <ImageView
            android:id="@+id/homeReferenceImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="false"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/aximo_home_reference" />

        <!-- Real, invisible interaction zones over the reference artwork. -->
        <View
            android:id="@+id/homeSettingsHit"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="10dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ustawienia" />

        <!-- Keep existing ViewBinding IDs alive while the reference screen is rendered as artwork. -->
        <TextView android:id="@+id/homeDate" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible" />
        <TextView android:id="@+id/homeGreeting" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible" />
        <LinearLayout android:id="@+id/nowCard" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible">
            <TextView android:id="@+id/nowLesson" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/nowLessonDetails" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/nowLessonCountdown" android:layout_width="1dp" android:layout_height="1dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/todaySummaryCard" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible">
            <TextView android:id="@+id/todayLessonsCount" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/todayTasksCount" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/todayAttendance" android:layout_width="1dp" android:layout_height="1dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/focusStatusCard" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible">
            <TextView android:id="@+id/focusStatusText" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/focusStatusDetails" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/focusStatusDot" android:layout_width="1dp" android:layout_height="1dp" />
        </LinearLayout>
        <HorizontalScrollView android:id="@+id/quickActions" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:id="@+id/quickPlan" android:layout_width="1dp" android:layout_height="1dp" />
                <TextView android:id="@+id/quickHomework" android:layout_width="1dp" android:layout_height="1dp" />
                <TextView android:id="@+id/quickGrades" android:layout_width="1dp" android:layout_height="1dp" />
                <TextView android:id="@+id/quickTomorrow" android:layout_width="1dp" android:layout_height="1dp" />
                <TextView android:id="@+id/quickMessages" android:layout_width="1dp" android:layout_height="1dp" />
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:id="@+id/configHint" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible">
            <Button android:id="@+id/configureCards" android:layout_width="1dp" android:layout_height="1dp" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            tools:listitem="@layout/card_home_timetable" />

    </FrameLayout>
</androidx.core.widget.NestedScrollView>
