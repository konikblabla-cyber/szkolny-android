<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aximo_home_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="96dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="700dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/aximo_home_hero_background"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="105dp">

            <TextView
                android:id="@+id/homeDate"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible"
                android:text=""/>

            <TextView
                android:id="@+id/homeGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="210dp"
                android:gravity="center"
                android:text="Cześć!"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Aximo"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Twój szkolny asystent"
                android:textColor="#E8E2FF"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Plan  •  Powiadomienia  •  Wyciszenie  •  Więcej"
                android:textColor="#C8C0E7"
                android:textSize="8sp"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:id="@+id/nowCard"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/aximo_home_greeting_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/aximo_avatar_background"
                    android:gravity="center"
                    android:text="●ᴗ●"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nowLesson"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cześć!"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/nowLessonDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="2"
                        android:text="Aximo jest gotowe pomóc Ci w szkolnym dniu."
                        android:textColor="#BDB8D5"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/nowLessonCountdown"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="invisible"
                        android:text=""/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/todaySummaryCard"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible">
                <TextView android:id="@+id/todayLessonsCount" android:layout_width="1dp" android:layout_height="1dp"/>
                <TextView android:id="@+id/todayTasksCount" android:layout_width="1dp" android:layout_height="1dp"/>
                <TextView android:id="@+id/todayAttendance" android:layout_width="1dp" android:layout_height="1dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/focusStatusCard"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible">
                <TextView android:id="@+id/focusStatusText" android:layout_width="1dp" android:layout_height="1dp"/>
                <TextView android:id="@+id/focusStatusDetails" android:layout_width="1dp" android:layout_height="1dp"/>
                <TextView android:id="@+id/focusStatusDot" android:layout_width="1dp" android:layout_height="1dp"/>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/quickActions"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:id="@+id/quickPlan" android:layout_width="1dp" android:layout_height="1dp"/>
                    <TextView android:id="@+id/quickHomework" android:layout_width="1dp" android:layout_height="1dp"/>
                    <TextView android:id="@+id/quickGrades" android:layout_width="1dp" android:layout_height="1dp"/>
                    <TextView android:id="@+id/quickTomorrow" android:layout_width="1dp" android:layout_height="1dp"/>
                    <TextView android:id="@+id/quickMessages" android:layout_width="1dp" android:layout_height="1dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/configHint"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible">
                <Button android:id="@+id/configureCards" android:layout_width="1dp" android:layout_height="1dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible"
                tools:listitem="@layout/card_home_timetable"/>

        </LinearLayout>

        <TextView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/aximo_icon_button_background"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="21sp"/>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>