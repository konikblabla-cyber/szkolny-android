<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="126dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="58dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Poniedziałek, 22 września"
                    android:textColor="#8F9DBB"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"/>
                <TextView
                    android:id="@+id/homeGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cześć!"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/homeSettingsHit"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/aximo_icon_button_background"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ustawienia"/>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/nowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/aximo_hero_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="●  TERAZ  /  NASTĘPNA LEKCJA"
                    android:textColor="#B58CFF"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/nowLessonCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sprawdzam…"
                    android:textColor="#C9D1E8"
                    android:textSize="11sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/nowLesson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Plan lekcji"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/nowLessonDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Ładowanie danych…"
                android:textColor="#9AA7C4"
                android:textSize="13sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/aximo_chip_background"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="● NA ŻYWO"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/aximo_more_card"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="DZISIAJ"
                    android:textColor="#D4BEFF"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Twój szkolny pulpit"
                    android:textColor="#AEB8D4"
                    android:textSize="10sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/aximo_chip_background"
                android:paddingStart="11dp"
                android:paddingTop="7dp"
                android:paddingEnd="11dp"
                android:paddingBottom="7dp"
                android:text="Otwórz plan  →"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Dzisiaj"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/todaySummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/aximo_section_background"
            android:orientation="horizontal"
            android:padding="8dp"
            android:elevation="2dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="82dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/todayLessonsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lekcje" android:textColor="#7F8BA8" android:textSize="11sp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="48dp" android:layout_gravity="center" android:background="#293653"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="82dp" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:background="@drawable/aximo_more_card" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/todayTasksCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zadania" android:textColor="#8793B1" android:textSize="11sp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="48dp" android:layout_gravity="center" android:background="#25304C"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="82dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/todayAttendance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Frekwencja" android:textColor="#8793B1" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Szybki dostęp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <HorizontalScrollView
            android:id="@+id/quickActions"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView android:id="@+id/quickPlan" style="@style/AximoHomeQuickCard" android:text="▣
PLAN LEKCJI"/>
                <TextView android:id="@+id/quickHomework" style="@style/AximoHomeQuickCard" android:text="✓
ZADANIA"/>
                <TextView android:id="@+id/quickGrades" style="@style/AximoHomeQuickCard" android:text="★
OCENY"/>
                <TextView android:id="@+id/quickTomorrow" style="@style/AximoHomeQuickCard" android:text="→
JUTRO"/>
                <TextView android:id="@+id/quickMessages" style="@style/AximoHomeQuickCard" android:text="✉
WIADOMOŚCI"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Centrum dnia"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/dayToolsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/aximo_section_background"
            android:padding="10dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dayAttendanceCard"
                    style="@style/AximoHomeQuickCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="◉
Frekwencja"/>

                <TextView
                    android:id="@+id/dayGradesCard"
                    style="@style/AximoHomeQuickCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="★
Oceny"/>

                <TextView
                    android:id="@+id/dayMessagesCard"
                    style="@style/AximoHomeQuickCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="✉
Wiadomości"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dayHomeworkCard"
                    style="@style/AximoHomeQuickCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="✓
Zadania"/>

                <TextView
                    android:id="@+id/dayTomorrowCard"
                    style="@style/AximoHomeQuickCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="→
Jutro"/>

                <TextView
                    android:id="@+id/daySearchCard"
                    style="@style/AximoHomeQuickCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="⌕
Szukaj"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/focusStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/aximo_focus_background"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/focusStatusDot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/aximo_focus_dot" android:text=""/>
                <TextView android:id="@+id/focusStatusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Tryb szkolny" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/focusStatusDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Automatyczne wyciszanie telefonu" android:textColor="#8F9DBB" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/configHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">
            <Button
                android:id="@+id/configureCards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Dostosuj"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            tools:listitem="@layout/card_home_timetable"/>

        <ImageView
            android:id="@+id/homeReferenceImage"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:src="@drawable/aximo_home_reference"
            android:contentDescription="@null"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>