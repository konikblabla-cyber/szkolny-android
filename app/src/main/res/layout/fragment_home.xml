<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aximo_home_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="112dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AXIMO"
                    android:textColor="#9B8CFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.18"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/homeGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Dzień dobry 👋"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/homeDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="145dp"
                android:gravity="end"
                android:text="Dzisiaj"
                android:textColor="#AAA9BC"
                android:textSize="13sp"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/aximo_hero_background"
                android:minHeight="190dp"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="NAJBLIŻEJ"
                        android:textColor="#DCD5FF"
                        android:textSize="12sp"
                        android:letterSpacing="0.12"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●  SZKOŁA"
                        android:textColor="#CFC8FF"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/nowLesson"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Ładowanie planu…"
                    android:textColor="#FFFFFF"
                    android:textSize="29sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/nowLessonDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Najbliższa lekcja"
                    android:textColor="#D7D2F0"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/nowLessonCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Start za —"
                    android:textColor="#B9ABFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="54dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:background="#B9ABFF"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/todaySummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/aximo_stat_background"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/todayLessonsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="LEKCJE"
                    android:textColor="#85849A"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:background="@drawable/aximo_stat_background"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/todayTasksCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ZADANIA"
                    android:textColor="#85849A"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/aximo_stat_background"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/todayAttendance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="FREKWENCJA"
                    android:textColor="#85849A"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/aximo_section_background"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Twój dzień"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAN"
                    android:textColor="#8F82FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:itemCount="1"
                tools:listitem="@layout/card_home_timetable"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/focusStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/aximo_focus_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="17dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/aximo_focus_icon_background"
                android:gravity="center"
                android:text="◉"
                android:textColor="#C5B9FF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRYB SZKOLNY"
                    android:textColor="#AFA3FF"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/focusStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Automatyczne wyciszanie jest aktywne"
                    android:textColor="#F3F1FA"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/focusStatusDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Aximo zajmie się resztą"
                    android:textColor="#88879A"
                    android:textSize="11sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/focusStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/aximo_focus_dot"
                android:text=""/>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/quickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quickPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/aximo_chip_background"
                    android:gravity="center"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="▦  Plan"
                    android:textColor="#E8E5F6"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/quickHomework"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/aximo_chip_background"
                    android:gravity="center"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="✓  Zadania"
                    android:textColor="#E8E5F6"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/quickGrades"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/aximo_chip_background"
                    android:gravity="center"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="★  Oceny"
                    android:textColor="#E8E5F6"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/quickTomorrow"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/aximo_chip_background"
                    android:gravity="center"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="→  Jutro"
                    android:textColor="#E8E5F6"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/quickMessages"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/aximo_chip_background"
                    android:gravity="center"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="✉  Wiadomości"
                    android:textColor="#E8E5F6"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/configHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_configure_notice"
                android:textColor="#77768A"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/configureCards"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_configure_add_remove"
                android:textColor="#A99DFF"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>