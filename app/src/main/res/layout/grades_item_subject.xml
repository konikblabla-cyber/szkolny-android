<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginHorizontal="4dp" android:layout_marginBottom="10dp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardBackgroundColor="#121B33" app:cardCornerRadius="22dp" app:cardElevation="0dp"
        app:strokeColor="#293A63" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="4dp" android:layout_height="28dp" android:layout_marginEnd="10dp" android:background="#8B5CF6"/>
                <TextView android:id="@+id/subjectName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:ellipsize="end" android:maxLines="2" android:textColor="#F4F1FF" android:textSize="17sp" android:textStyle="bold" tools:text="systemy operacyjne"/>
                <View android:id="@+id/unread" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginHorizontal="9dp"
                    android:background="@drawable/unread_red_circle" android:visibility="gone" tools:visibility="visible"/>
                <com.mikepenz.iconics.view.IconicsImageView android:id="@+id/dropdownIcon" android:layout_width="30dp" android:layout_height="30dp"
                    android:scaleType="centerInside" app:iiv_color="#9EA9C5" app:iiv_icon="cmd-chevron-down" app:iiv_size="21dp"/>
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:id="@+id/previewContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal" tools:visibility="visible">
                    <LinearLayout android:id="@+id/gradesContainer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/yearContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">
                    <TextView android:id="@+id/yearSummary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:textAppearance="?textAppearanceBodySmall" android:textColor="#8F9DBB" android:visibility="gone"
                        tools:text="Cały rok: 6 ocen • średnia: 4,25" tools:visibility="visible"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>