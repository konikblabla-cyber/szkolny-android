<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/transparent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="16dp"
        android:paddingEnd="18dp" android:paddingBottom="120dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="@drawable/aximo_chip_background">
            <ImageButton android:id="@+id/backButton" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/aximo_icon_button_background" android:contentDescription="Wstecz"
                android:src="@drawable/ic_aximo_back" android:tint="#FFFFFF"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ustawienia Aximo" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dostosuj dziennik dokładnie pod siebie" android:textColor="#B98AFF" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/settingsTabs" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal"/>
        </HorizontalScrollView>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="3dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/settingsPlan" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:background="@drawable/aximo_chip_background" android:text="▣ Plan" android:textColor="#FFFFFF" android:textSize="13sp"/>
                <TextView android:id="@+id/settingsGrades" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:background="@drawable/aximo_chip_background" android:text="★ Oceny" android:textColor="#FFFFFF" android:textSize="13sp"/>
                <TextView android:id="@+id/settingsAttendance" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:background="@drawable/aximo_chip_background" android:text="◉ Frekwencja" android:textColor="#FFFFFF" android:textSize="13sp"/>
                <TextView android:id="@+id/settingsMessages" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:background="@drawable/aximo_chip_background" android:text="✉ Wiadomości" android:textColor="#FFFFFF" android:textSize="13sp"/>
                <TextView android:id="@+id/settingsHomework" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:background="@drawable/aximo_chip_background" android:text="✓ Zadania" android:textColor="#FFFFFF" android:textSize="13sp"/>
                <TextView android:id="@+id/settingsAppearance" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:background="@drawable/aximo_chip_background" android:text="🎨 Wygląd" android:textColor="#FFFFFF" android:textSize="13sp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView android:id="@+id/categoryTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Ekran główny" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/categoryDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="Co ma być widoczne po uruchomieniu Aximo." android:textColor="#7F8AA8" android:textSize="13sp"/>

        <LinearLayout android:id="@+id/categoryHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <LinearLayout android:id="@+id/categoryNavigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
        <LinearLayout android:id="@+id/categoryDiary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
        <LinearLayout android:id="@+id/categoryNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
        <LinearLayout android:id="@+id/categorySchool" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
        <LinearLayout android:id="@+id/categoryPersonal" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
        <LinearLayout android:id="@+id/categoryAdvanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>

        <TextView android:id="@+id/settingsFooter" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:gravity="center" android:text="Zmiany zapisują się automatycznie." android:textColor="#69738F" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>