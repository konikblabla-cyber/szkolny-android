<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep app data restorable after reinstall. Cookies are intentionally excluded. -->
        <exclude domain="sharedpref" path="cookies.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Transfer the same app data when moving to another Android device. -->
        <exclude domain="sharedpref" path="cookies.xml" />
    </device-transfer>
</data-extraction-rules>
